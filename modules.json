        "responsibility": "Provide dependency-ordered durable operation execution with immutable plans, fenced attempts, explicit retry and unknown-outcome policy, bounded fleet lifecycle, persistent stores, and selectable integration adapters.",
        "non_goals": [
          "Own application operations, business transactions, external side effects, process signals, queue settlement, database pools, credentials, or observability backends.",
          "Replace schema migrations, recurring time-based scheduling, workflow engines, queues, leases, retries, or idempotency packages that own those reusable domain contracts."
        ],
        "public_package_identifier": "sequencer",
        "primary_entry_packages": [
          "github.com/faustbrian/go-sequencer"
        ],
        "package_selection": {
          "github.com/faustbrian/go-sequencer": "Use for immutable dependency plans, fenced durable attempts, synchronous runners, leaderless fleet execution, explicit retry ownership, and unknown-outcome reconciliation.",
          "github.com/faustbrian/go-sequencer/goidempotency": "Use to adapt an application idempotency gate to sequencer attempt execution with bounded terminal cleanup.",
          "github.com/faustbrian/go-sequencer/golease": "Use to adapt an external fenced lease acquirer to sequencer execution with bounded release cleanup.",
          "github.com/faustbrian/go-sequencer/goqueue": "Use to publish sequencer requests or execute delivered requests with explicit acknowledgement and rejection settlement.",
          "github.com/faustbrian/go-sequencer/goretry": "Use for inline retry classification and execution against the shared sequencer attempt budget.",
          "github.com/faustbrian/go-sequencer/memory": "Use for deterministic process-local store, lease, and queue behavior where restart durability is unnecessary.",
          "github.com/faustbrian/go-sequencer/migrations": "Use to assert application schema-version prerequisites without making sequencer own migration history.",
          "github.com/faustbrian/go-sequencer/postgres": "Use for durable fenced sequencer state backed by a caller-owned PostgreSQL pool.",
          "github.com/faustbrian/go-sequencer/scheduler": "Use to translate an external scheduling destination into sequencer operation requests.",
          "github.com/faustbrian/go-sequencer/sequencehttp": "Use to expose bounded inspection, reset, and reconciliation controls behind a caller-supplied authorizer.",
          "github.com/faustbrian/go-sequencer/sequencertest": "Use in tests for deterministic clocks, operation fixtures, and fault-injecting store behavior."
        },
