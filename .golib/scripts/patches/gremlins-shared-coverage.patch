@@ -144,0 +161,29 @@
+	if sourcePath := os.Getenv("GOLIB_GREMLINS_COVERAGE_PROFILE"); sourcePath != "" {
+		elapsedText := os.Getenv("GOLIB_GREMLINS_COVERAGE_ELAPSED")
+		elapsed, err := time.ParseDuration(elapsedText)
+		if err != nil || elapsed <= 0 {
+			return 0, fmt.Errorf("invalid external coverage elapsed duration %q", elapsedText)
