+func (c *Coverage) executeUnitBaseline() error {
+	cmd := c.cmdContext("go", "test", "-count=1", "./...")
+	if out, err := cmd.CombinedOutput(); err != nil {
+		log.Infof("\n%s\n", string(out))
+
